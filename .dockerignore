# =============================================================================
# Docker Ignore File for XIASS API
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
!deploy/DOCKER.md
docs/*
# admin-compliance gate (LegalDocumentView.vue) build-time imports
# docs/legal/*.md?raw into the frontend bundle; keep that subtree in the
# Docker build context even though docs/ is otherwise excluded.
!docs/legal/
!docs/legal/**

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
release/
artifacts/
backups/
historical/
operations/
infrastructure/
supporting-tools/
.cache/
.gocache/
backend/.gocache/
backend/bin/
backend/server
backend/sub2api
backend/main
backend/internal/web/dist/
**/*.tsbuildinfo

# Node modules (will be installed in container)
frontend/node_modules/
node_modules/
**/node_modules/

# Go build cache (will be built in container)
backend/vendor/

# Test files
*_test.go
**/*_test.go
**/*.test.js
**/*.test.mjs
**/*.test.ts
**/*.spec.ts
**/__tests__/
# The production frontend build runs this locale contract check before Vite.
# Keep only that build-time test in the image context; other tests stay ignored.
!frontend/src/i18n/__tests__/
frontend/src/i18n/__tests__/*
!frontend/src/i18n/__tests__/localeKeyCompleteness.spec.ts
!frontend/src/__tests__/
frontend/src/__tests__/*
!frontend/src/__tests__/setup.ts
deploy/tests/
coverage/
**/coverage/
.nyc_output/

# Environment files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Local config
config.yaml
config.local.yaml
**/config.yaml
**/config.local.yaml
backend/.installed

# Logs
*.log
**/*.log
logs/

# Temporary files
tmp/
temp/
*.tmp
**/*.tmp

# Deploy files (not needed in image)
deploy/install.sh
deploy/sub2api.service
deploy/sub2api-sudoers
deploy/data/
deploy/postgres_data/
deploy/redis_data/
backend/data/
deploy/ha/
deploy/backups/
deploy/backup/

# GoReleaser
.goreleaser.yaml
.goreleaser.simple.yaml

# GitHub
.github/

# Claude files
.claude/
issues/
CLAUDE.md
